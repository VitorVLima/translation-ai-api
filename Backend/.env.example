# Copy to .env and fill in the secrets. Never commit .env.
# Shared Spring properties / Docker Compose format: KEY=value, without quotes.
# Do not use export, inline comments, or literal backslashes in values.
# Restart the application after changing this file.

SERVER_PORT=8080
# Docker Compose publishes only the Backend here by default. Keep loopback for local use;
# a production reverse proxy may set a trusted private bind address instead.
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8080
# In prod/production, set an existing writable ABSOLUTE path on persistent storage.
# Docker Compose overrides this with its persistent avatar volume path.
# Before changing paths, copy existing runtime avatar files from the old data/profile-images directory.
AVATAR_IMAGE_STORAGE_DIR=./data/profile-images
DB_HOST=localhost
DB_PORT=5434
# Local IDE/Maven runs use the PostgreSQL address above, without Spring Boot service discovery.
SPRING_DOCKER_COMPOSE_ENABLED=false
# DB_HOST and DB_PORT above are for running the Backend outside Docker;
# Compose overrides them with postgres:5432 and does not publish PostgreSQL.
POSTGRES_DB=mydatabase
POSTGRES_USER=myuser
# Must match the password of your existing PostgreSQL database.
POSTGRES_PASSWORD=

# Base64-encoded random key containing at least 32 bytes. Required to start.
JWT_SECRET=
JWT_EXPIRATION_SECONDS=900
# Development-only safe JWT validation diagnostics (fingerprint and rejection reason only).
JWT_DIAGNOSTICS_ENABLED=false

# Google OIDC client ID. Leave empty to keep Google login disabled locally.
GOOGLE_CLIENT_ID=
# Comma-separated, exact browser origins only. For LAN development, append the
# current frontend origin (for example, http://192.168.100.18:5500). Do not use wildcards.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501
SECURITY_GOOGLE_CLOCK_SKEW_SECONDS=60
SECURITY_GOOGLE_JWKS_CONNECT_TIMEOUT_MILLIS=2000
SECURITY_GOOGLE_JWKS_READ_TIMEOUT_MILLIS=3000
SECURITY_GOOGLE_NONCE_TTL_SECONDS=300
SECURITY_GOOGLE_NONCE_CACHE_MAX_SIZE=10000

# Base64-encoded random key containing at least 32 bytes. Required when refresh tokens are enabled.
SECURITY_REFRESH_TOKEN_HASH_SECRET=
## Enable after reviewing retention and the first production database backup.
## Cleanup runs daily at 03:17 UTC; each table is processed in small transactions.
## All tokens in a family remain through family expiry plus the retention period.
SECURITY_RETENTION_ENABLED=false
SECURITY_RETENTION_CLEANUP_CRON=0 17 3 * * *
SECURITY_RETENTION_BATCH_SIZE=200
SECURITY_RETENTION_MAX_BATCHES_PER_TABLE=10
SECURITY_RETENTION_CODE_DAYS_AFTER_EXPIRY=7
SECURITY_RETENTION_FAMILY_DAYS_AFTER_EXPIRY=30

# Base64-encoded random key containing at least 32 bytes for rate-limit account keys.
SECURITY_RATE_LIMIT_KEY_SECRET=
SECURITY_RATE_LIMIT_CACHE_MAX_SIZE=10000
SECURITY_RATE_LIMIT_CACHE_TTL_SECONDS=900
SECURITY_RATE_LIMIT_LOGIN_CAPACITY=10
SECURITY_RATE_LIMIT_LOGIN_WINDOW_SECONDS=600
SECURITY_RATE_LIMIT_LOGIN_ACCOUNT_CAPACITY=5
SECURITY_RATE_LIMIT_LOGIN_ACCOUNT_WINDOW_SECONDS=600
SECURITY_RATE_LIMIT_REGISTER_CAPACITY=3
SECURITY_RATE_LIMIT_REGISTER_WINDOW_SECONDS=600
SECURITY_RATE_LIMIT_REFRESH_CAPACITY=30
SECURITY_RATE_LIMIT_REFRESH_WINDOW_SECONDS=60
SECURITY_RATE_LIMIT_LOGOUT_CAPACITY=30
SECURITY_RATE_LIMIT_LOGOUT_WINDOW_SECONDS=60
SECURITY_RATE_LIMIT_VERIFY_EMAIL_IP_CAPACITY=10
SECURITY_RATE_LIMIT_VERIFY_EMAIL_ACCOUNT_CAPACITY=5
SECURITY_RATE_LIMIT_VERIFY_EMAIL_WINDOW_SECONDS=600
SECURITY_RATE_LIMIT_RESEND_VERIFICATION_IP_CAPACITY=5
SECURITY_RATE_LIMIT_RESEND_VERIFICATION_ACCOUNT_CAPACITY=3
SECURITY_RATE_LIMIT_RESEND_VERIFICATION_WINDOW_SECONDS=600
SECURITY_EMAIL_VERIFICATION_CODE_HASH_SECRET=
SECURITY_EMAIL_VERIFICATION_CODE_EXPIRATION_SECONDS=600
SECURITY_EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# Base64-encoded random key containing at least 32 bytes for password reset code hashes.
SECURITY_PASSWORD_RESET_CODE_HASH_SECRET=
SECURITY_PASSWORD_RESET_CODE_EXPIRATION_SECONDS=600
SECURITY_PASSWORD_RESET_MAX_ATTEMPTS=5

# Password reset endpoint rate limits.
SECURITY_RATE_LIMIT_RESET_PASSWORD_IP_CAPACITY=10
SECURITY_RATE_LIMIT_RESET_PASSWORD_ACCOUNT_CAPACITY=5
SECURITY_RATE_LIMIT_RESET_PASSWORD_WINDOW_SECONDS=600
SECURITY_RATE_LIMIT_GOOGLE_LOGIN_CAPACITY=10
SECURITY_RATE_LIMIT_GOOGLE_LOGIN_WINDOW_SECONDS=600

# Local development/test default is noop. Production must activate the prod (or production)
# Spring profile and set MAIL_PROVIDER=smtp; startup fails if SMTP settings are missing.
# Supply MAIL_PASSWORD through the deployment secret store, never commit a populated .env.
# SMTP timeouts are milliseconds: connect 5s, write 5s and read 10s by default.
MAIL_PROVIDER=noop
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true
MAIL_SMTP_CONNECTION_TIMEOUT_MS=5000
MAIL_SMTP_WRITE_TIMEOUT_MS=5000
MAIL_SMTP_READ_TIMEOUT_MS=10000

# LLM provider (ollama or gemini). Ollama is the development default.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_RESPONSE_TIMEOUT_SECONDS=120
AI_TRANSLATION_MAX_CHARACTERS=5000
# Per-instance AI admission. Defaults assume one initial Backend instance, a 10-connection
# Hikari pool and provider timeouts of 120s (LLM/STT) / 60s (TTS).
# One account may use 2 distinct LLM operations concurrently, never two of the same operation.
# Tune from measured latency, heap, provider quota and the number of Backend replicas.
AI_RATE_CACHE_MAX_SIZE=10000
AI_LLM_PER_HOUR=30
AI_LLM_PER_OPERATION_MINUTE=6
AI_AUDIO_PER_OPERATION_MINUTE=12
AI_AUDIO_PER_HOUR=120
AI_LLM_PER_USER_CONCURRENT=2
AI_LLM_GLOBAL_CONCURRENT=8
AI_STT_GLOBAL_CONCURRENT=2
AI_TTS_GLOBAL_CONCURRENT=2
AI_SSE_GLOBAL_CONCURRENT=6
AI_SSE_THREADS=4
AI_SSE_QUEUE_SIZE=2
AI_SSE_TIMEOUT_MS=130000
STT_PROVIDER=whisper
WHISPER_BASE_URL=http://127.0.0.1:8001
STT_CONNECT_TIMEOUT_SECONDS=5
STT_RESPONSE_TIMEOUT_SECONDS=120
STT_MAX_FILE_SIZE_MB=20
# Must exceed the file limit to allow multipart framing at the exact file boundary.
STT_MAX_REQUEST_SIZE_MB=21
TTS_PROVIDER=piper
PIPER_BASE_URL=http://127.0.0.1:8002
TTS_CONNECT_TIMEOUT_SECONDS=5
TTS_RESPONSE_TIMEOUT_SECONDS=60
TTS_MAX_TEXT_LENGTH=3000
TTS_MAX_AUDIO_MB=20

# Docker Compose model mounts. Do not put models in Git or Docker build contexts.
# Set WHISPER_MODEL_CACHE_DIR to the absolute host directory containing the prepared
# Hugging Face cache (for example, C:/Users/you/.cache/huggingface). It is mounted read-only.
WHISPER_MODEL_CACHE_DIR=
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_PRELOAD_MODEL=true
# These are paths inside the Piper container. The host voices/ directory is mounted read-only.
PIPER_EXECUTABLE=piper
PIPER_EN_MODEL_PATH=/models/en/en_US-hfc_female-medium.onnx
PIPER_PT_MODEL_PATH=/models/pt/pt_BR-faber-medium.onnx
PIPER_SYNTHESIS_TIMEOUT_SECONDS=30
PIPER_EN_LENGTH_SCALE=1.0
PIPER_WARMUP_ENABLED=true

# Optional bootstrap of the single existing SUPER_ADMIN account. Never creates users.
SUPER_ADMIN_BOOTSTRAP_EMAIL=
# Legacy optional bootstrap for one ADMIN account.
ADMIN_BOOTSTRAP_EMAIL=
