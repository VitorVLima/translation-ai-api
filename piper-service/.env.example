# Local Piper configuration. Copy this file to .env and adjust the paths.
PIPER_EXECUTABLE=C:/path/to/piper.exe
PIPER_EN_MODEL_PATH=C:/path/to/english-voice.onnx
PIPER_PT_MODEL_PATH=C:/path/to/portuguese-voice.onnx
PIPER_MAX_TEXT_LENGTH=3000
PIPER_SYNTHESIS_TIMEOUT_SECONDS=30
PIPER_EN_LENGTH_SCALE=1.0
PIPER_LOG_LEVEL=INFO
