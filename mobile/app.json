{
  "expo": {
    "name": "EnglishAI",
    "slug": "englishai",
    "scheme": "englishai",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/icon.png",

    "userInterfaceStyle": "light",

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "package": "com.englishai.app",
      "softwareKeyboardLayoutMode": "resize",

      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-safe.png",
        "backgroundColor": "#5B3DF5"
      },

      "predictiveBackGestureEnabled": false
    },

    "web": {
      "favicon": "./assets/favicon.png"
    },

    "plugins": [
      "expo-secure-store",
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Permita que o EnglishAI use o microfone para praticar conversa por voz."
        }
      ]
    ]
  }
}
